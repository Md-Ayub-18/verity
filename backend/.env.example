# Verity Backend Environment Configuration

# PostgreSQL Connection String (Recommended for Production / PostgreSQL mode)
# DATABASE_URL=postgresql://verity:verity_password@localhost:5432/verity_db

# Local SQLite fallback (Default when PostgreSQL is not configured)
DATABASE_URL=sqlite:///./verity.db

# JWT Secret Key (Change in production!)
SECRET_KEY=verity_super_secret_jwt_key_responsibly_built_2026

# FFmpeg Path (Optional if ffmpeg is on system PATH)
# FFMPEG_PATH=ffmpeg

